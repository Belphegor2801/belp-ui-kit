{
  "name": "belp-ui-kit",
  "version": "0.1.0",
  "type": "module",
  "description": "Modern data-centric custom UI component library with unified design tokens and headless accessibility",
  "main": "./dist/belp-ui-kit.umd.js",
  "module": "./dist/belp-ui-kit.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/belp-ui-kit.es.js",
      "require": "./dist/belp-ui-kit.umd.js"
    },
    "./style.css": "./dist/belp-ui-kit.css",
    "./dist/belp-ui-kit.css": "./dist/belp-ui-kit.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --port 5173 --host",
    "build": "tsc && vite build --mode library",
    "build:showcase": "tsc && vite build",
    "preview": "vite preview --outDir dist-showcase --port 4173 --host"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
